{
  "name": "lms",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @lms/api dev",
    "dev:web": "pnpm --filter @lms/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "dotenv -e .env -- pnpm --filter @lms/shared db:migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter @lms/shared db:deploy",
    "db:generate": "dotenv -e .env -- pnpm --filter @lms/shared db:generate",
    "db:studio": "dotenv -e .env -- pnpm --filter @lms/shared db:studio",
    "db:seed": "dotenv -e .env -- pnpm --filter @lms/shared db:seed"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
