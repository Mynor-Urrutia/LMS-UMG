# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://lms_user:CHANGE_ME@localhost:3306/lms_db"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="CHANGE_ME_min_64_chars_random_string"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=7

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DEST="./uploads"
MAX_FILE_SIZE_MB=50

# ─── Throttle ─────────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── MySQL (docker-compose) ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD="CHANGE_ME_strong_root_password"
MYSQL_PASSWORD="CHANGE_ME_strong_app_password"
