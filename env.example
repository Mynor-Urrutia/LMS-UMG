# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://lms_user:CHANGE_ME@localhost:3306/lms_db"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="CHANGE_ME_min_32_chars_random_string_access"
JWT_REFRESH_SECRET="CHANGE_ME_min_32_chars_random_string_refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECRET="CHANGE_ME_min_16_chars_cookie_secret"

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ─── File Uploads (reference only — hardcoded in code) ────────────────────────
# UPLOAD_DEST="./uploads"
# MAX_FILE_SIZE_MB=50

# ─── Throttle ─────────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ─── SMTP (optional — omit to disable email notifications) ────────────────────
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="no-reply@example.com"
# SMTP_PASS="CHANGE_ME"
# SMTP_FROM="LMS <no-reply@example.com>"

# ─── MySQL (docker-compose) ───────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD="CHANGE_ME_strong_root_password"
MYSQL_PASSWORD="CHANGE_ME_strong_app_password"

# ─── Next.js public (only needed for docker-compose builds) ───────────────────
# NEXT_PUBLIC_API_URL="https://yourdomain.com"
